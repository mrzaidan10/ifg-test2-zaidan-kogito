<?xml version="1.0" encoding="UTF-8" ?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="Definitions_Checkout" targetNamespace="http://example.com/checkout">
  <bpmn2:itemDefinition id="ItemDefinition_CheckoutRequest" structureRef="com.example.checkout.model.CheckoutRequest" />
  <bpmn2:itemDefinition id="ItemDefinition_Boolean" structureRef="java.lang.Boolean" />
  <bpmn2:itemDefinition id="ItemDefinition_String" structureRef="java.lang.String" />
  <bpmn2:interface id="Interface_CartService" name="com.example.checkout.service.CartService" implementationRef="com.example.checkout.service.CartService">
    <bpmn2:operation id="Operation_ValidateCart" name="validateCart" implementationRef="validateCart" />
  </bpmn2:interface>
  <bpmn2:interface id="Interface_InventoryService" name="com.example.checkout.service.InventoryService" implementationRef="com.example.checkout.service.InventoryService">
    <bpmn2:operation id="Operation_CheckInventory" name="checkInventory" implementationRef="checkInventory" />
    <bpmn2:operation id="Operation_UpdateInventory" name="updateInventory" implementationRef="updateInventory" />
  </bpmn2:interface>
  <bpmn2:interface id="Interface_PaymentService" name="com.example.checkout.service.PaymentService" implementationRef="com.example.checkout.service.PaymentService">
    <bpmn2:operation id="Operation_ProcessPayment" name="processPayment" implementationRef="processPayment" />
  </bpmn2:interface>
  <bpmn2:interface id="Interface_OrderService" name="com.example.checkout.service.OrderService" implementationRef="com.example.checkout.service.OrderService">
    <bpmn2:operation id="Operation_CreateOrder" name="createOrder" implementationRef="createOrder" />
  </bpmn2:interface>
  <bpmn2:interface id="Interface_NotificationService" name="com.example.checkout.service.NotificationService" implementationRef="com.example.checkout.service.NotificationService">
    <bpmn2:operation id="Operation_SendConfirmation" name="sendConfirmation" implementationRef="sendConfirmation" />
  </bpmn2:interface>
  <bpmn2:interface id="Interface_CheckoutService" name="com.example.checkout.service.CheckoutService" implementationRef="com.example.checkout.service.CheckoutService">
    <bpmn2:operation id="Operation_RejectCheckout" name="rejectCheckout" implementationRef="rejectCheckout" />
    <bpmn2:operation id="Operation_OutOfStock" name="handleOutOfStock" implementationRef="handleOutOfStock" />
    <bpmn2:operation id="Operation_PaymentFailure" name="handlePaymentFailure" implementationRef="handlePaymentFailure" />
    <bpmn2:operation id="Operation_CompleteCheckout" name="completeCheckout" implementationRef="completeCheckout" />
  </bpmn2:interface>
  <bpmn2:process id="Process_Checkout" name="Marketplace Checkout" isExecutable="true" processType="Public">
    <bpmn2:property id="Property_Request" name="request" itemSubjectRef="ItemDefinition_CheckoutRequest" />
    <bpmn2:property id="Property_CartValid" name="cartValid" itemSubjectRef="ItemDefinition_Boolean" />
    <bpmn2:property id="Property_StockAvailable" name="stockAvailable" itemSubjectRef="ItemDefinition_Boolean" />
    <bpmn2:property id="Property_PaymentSuccessful" name="paymentSuccessful" itemSubjectRef="ItemDefinition_Boolean" />
    <bpmn2:property id="Property_OrderId" name="orderId" itemSubjectRef="ItemDefinition_String" />
    <bpmn2:startEvent id="StartEvent_Checkout" name="Checkout Request">
      <bpmn2:outgoing>
                Flow_Start_ValidateCart
            </bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:endEvent id="EndEvent_Rejected" name="Checkout Rejected">
      <bpmn2:incoming>
                Flow_Reject_End
            </bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="EndEvent_OutOfStock" name="Out of Stock">
      <bpmn2:incoming>
                Flow_OutOfStock_End
            </bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="EndEvent_PaymentFailed" name="Payment Failed">
      <bpmn2:incoming>
                Flow_PaymentFailed_End
            </bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="EndEvent_Completed" name="Checkout Completed">
      <bpmn2:incoming>
                Flow_Complete_End
            </bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:exclusiveGateway id="Gateway_CartValid" name="Cart Valid?" gatewayDirection="Diverging">
      <bpmn2:incoming>
                Flow_ValidateCart_Gateway
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_CartValid_Yes
            </bpmn2:outgoing>
      <bpmn2:outgoing>
                Flow_CartValid_No
            </bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="Gateway_StockAvailable" name="Stock Available?" gatewayDirection="Diverging">
      <bpmn2:incoming>
                Flow_CheckInventory_Gateway
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_StockAvailable_Yes
            </bpmn2:outgoing>
      <bpmn2:outgoing>
                Flow_StockAvailable_No
            </bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="Gateway_PaymentSuccessful" name="Payment Successful?" gatewayDirection="Diverging">
      <bpmn2:incoming>
                Flow_ProcessPayment_Gateway
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_PaymentSuccessful_Yes
            </bpmn2:outgoing>
      <bpmn2:outgoing>
                Flow_PaymentSuccessful_No
            </bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:serviceTask id="Task_ValidateCart" name="Validate Cart" implementation="Java" operationRef="Operation_ValidateCart" drools:serviceimplementation="Java" drools:serviceinterface="com.example.checkout.service.CartService" drools:serviceoperation="validateCart">
      <bpmn2:incoming>
                Flow_Start_ValidateCart
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_ValidateCart_Gateway
            </bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_ValidateCart" name="request" itemSubjectRef="ItemDefinition_CheckoutRequest" />
        <bpmn2:dataOutput id="DataOutput_CartValid" name="cartValid" itemSubjectRef="ItemDefinition_Boolean" />
        <bpmn2:inputSet id="InputSet_ValidateCart">
          <bpmn2:dataInputRefs>
                        DataInput_ValidateCart
                    </bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="OutputSet_ValidateCart">
          <bpmn2:dataOutputRefs>
                        DataOutput_CartValid
                    </bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>
                    Property_Request
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    DataInput_ValidateCart
                </bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>
                    DataOutput_CartValid
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    Property_CartValid
                </bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Task_RejectCheckout" name="Reject Checkout" implementation="Java" operationRef="Operation_RejectCheckout" drools:serviceimplementation="Java" drools:serviceinterface="com.example.checkout.service.CheckoutService" drools:serviceoperation="rejectCheckout">
      <bpmn2:incoming>
                Flow_CartValid_No
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_Reject_End
            </bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_RejectCheckout" name="request" itemSubjectRef="ItemDefinition_CheckoutRequest" />
        <bpmn2:inputSet id="InputSet_RejectCheckout">
          <bpmn2:dataInputRefs>
                        DataInput_RejectCheckout
                    </bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="OutputSet_RejectCheckout" />
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>
                    Property_Request
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    DataInput_RejectCheckout
                </bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Task_CheckInventory" name="Check Inventory" implementation="Java" operationRef="Operation_CheckInventory" drools:serviceimplementation="Java" drools:serviceinterface="com.example.checkout.service.InventoryService" drools:serviceoperation="checkInventory">
      <bpmn2:incoming>
                Flow_CartValid_Yes
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_CheckInventory_Gateway
            </bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_CheckInventory" name="request" itemSubjectRef="ItemDefinition_CheckoutRequest" />
        <bpmn2:dataOutput id="DataOutput_StockAvailable" name="stockAvailable" itemSubjectRef="ItemDefinition_Boolean" />
        <bpmn2:inputSet id="InputSet_CheckInventory">
          <bpmn2:dataInputRefs>
                        DataInput_CheckInventory
                    </bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="OutputSet_CheckInventory">
          <bpmn2:dataOutputRefs>
                        DataOutput_StockAvailable
                    </bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>
                    Property_Request
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    DataInput_CheckInventory
                </bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>
                    DataOutput_StockAvailable
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    Property_StockAvailable
                </bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Task_OutOfStock" name="Out of Stock" implementation="Java" operationRef="Operation_OutOfStock" drools:serviceimplementation="Java" drools:serviceinterface="com.example.checkout.service.CheckoutService" drools:serviceoperation="handleOutOfStock">
      <bpmn2:incoming>
                Flow_StockAvailable_No
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_OutOfStock_End
            </bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_OutOfStock" name="request" itemSubjectRef="ItemDefinition_CheckoutRequest" />
        <bpmn2:inputSet id="InputSet_OutOfStock">
          <bpmn2:dataInputRefs>
                        DataInput_OutOfStock
                    </bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="OutputSet_OutOfStock" />
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>
                    Property_Request
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    DataInput_OutOfStock
                </bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Task_ProcessPayment" name="Process Payment" implementation="Java" operationRef="Operation_ProcessPayment" drools:serviceimplementation="Java" drools:serviceinterface="com.example.checkout.service.PaymentService" drools:serviceoperation="processPayment">
      <bpmn2:incoming>
                Flow_StockAvailable_Yes
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_ProcessPayment_Gateway
            </bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_ProcessPayment" name="request" itemSubjectRef="ItemDefinition_CheckoutRequest" />
        <bpmn2:dataOutput id="DataOutput_PaymentSuccessful" name="paymentSuccessful" itemSubjectRef="ItemDefinition_Boolean" />
        <bpmn2:inputSet id="InputSet_ProcessPayment">
          <bpmn2:dataInputRefs>
                        DataInput_ProcessPayment
                    </bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="OutputSet_ProcessPayment">
          <bpmn2:dataOutputRefs>
                        DataOutput_PaymentSuccessful
                    </bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>
                    Property_Request
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    DataInput_ProcessPayment
                </bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>
                    DataOutput_PaymentSuccessful
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    Property_PaymentSuccessful
                </bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Task_PaymentFailed" name="Payment Failed" implementation="Java" operationRef="Operation_PaymentFailure" drools:serviceimplementation="Java" drools:serviceinterface="com.example.checkout.service.CheckoutService" drools:serviceoperation="handlePaymentFailure">
      <bpmn2:incoming>
                Flow_PaymentSuccessful_No
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_PaymentFailed_End
            </bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_PaymentFailed" name="request" itemSubjectRef="ItemDefinition_CheckoutRequest" />
        <bpmn2:inputSet id="InputSet_PaymentFailed">
          <bpmn2:dataInputRefs>
                        DataInput_PaymentFailed
                    </bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="OutputSet_PaymentFailed" />
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>
                    Property_Request
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    DataInput_PaymentFailed
                </bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Task_CreateOrder" name="Create Order" implementation="Java" operationRef="Operation_CreateOrder" drools:serviceimplementation="Java" drools:serviceinterface="com.example.checkout.service.OrderService" drools:serviceoperation="createOrder">
      <bpmn2:incoming>
                Flow_PaymentSuccessful_Yes
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_CreateOrder_UpdateInventory
            </bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_CreateOrder" name="request" itemSubjectRef="ItemDefinition_CheckoutRequest" />
        <bpmn2:dataOutput id="DataOutput_OrderId" name="orderId" itemSubjectRef="ItemDefinition_String" />
        <bpmn2:inputSet id="InputSet_CreateOrder">
          <bpmn2:dataInputRefs>
                        DataInput_CreateOrder
                    </bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="OutputSet_CreateOrder">
          <bpmn2:dataOutputRefs>
                        DataOutput_OrderId
                    </bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>
                    Property_Request
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    DataInput_CreateOrder
                </bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>
                    DataOutput_OrderId
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    Property_OrderId
                </bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Task_UpdateInventory" name="Update Inventory" implementation="Java" operationRef="Operation_UpdateInventory" drools:serviceimplementation="Java" drools:serviceinterface="com.example.checkout.service.InventoryService" drools:serviceoperation="updateInventory">
      <bpmn2:incoming>
                Flow_CreateOrder_UpdateInventory
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_UpdateInventory_Confirmation
            </bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_UpdateInventory" name="request" itemSubjectRef="ItemDefinition_CheckoutRequest" />
        <bpmn2:inputSet id="InputSet_UpdateInventory">
          <bpmn2:dataInputRefs>
                        DataInput_UpdateInventory
                    </bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="OutputSet_UpdateInventory" />
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>
                    Property_Request
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    DataInput_UpdateInventory
                </bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Task_SendConfirmation" name="Send Confirmation" implementation="Java" operationRef="Operation_SendConfirmation" drools:serviceimplementation="Java" drools:serviceinterface="com.example.checkout.service.NotificationService" drools:serviceoperation="sendConfirmation">
      <bpmn2:incoming>
                Flow_UpdateInventory_Confirmation
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_Confirmation_Complete
            </bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_SendConfirmation" name="orderId" itemSubjectRef="ItemDefinition_String" />
        <bpmn2:inputSet id="InputSet_SendConfirmation">
          <bpmn2:dataInputRefs>
                        DataInput_SendConfirmation
                    </bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="OutputSet_SendConfirmation" />
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>
                    Property_OrderId
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    DataInput_SendConfirmation
                </bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Task_CompleteCheckout" name="Checkout Completed" implementation="Java" operationRef="Operation_CompleteCheckout" drools:serviceimplementation="Java" drools:serviceinterface="com.example.checkout.service.CheckoutService" drools:serviceoperation="completeCheckout">
      <bpmn2:incoming>
                Flow_Confirmation_Complete
            </bpmn2:incoming>
      <bpmn2:outgoing>
                Flow_Complete_End
            </bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_CompleteCheckout" name="request" itemSubjectRef="ItemDefinition_CheckoutRequest" />
        <bpmn2:inputSet id="InputSet_CompleteCheckout">
          <bpmn2:dataInputRefs>
                        DataInput_CompleteCheckout
                    </bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="OutputSet_CompleteCheckout" />
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>
                    Property_Request
                </bpmn2:sourceRef>
        <bpmn2:targetRef>
                    DataInput_CompleteCheckout
                </bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:serviceTask>
    <bpmn2:sequenceFlow id="Flow_Start_ValidateCart" sourceRef="StartEvent_Checkout" targetRef="Task_ValidateCart" />
    <bpmn2:sequenceFlow id="Flow_ValidateCart_Gateway" sourceRef="Task_ValidateCart" targetRef="Gateway_CartValid" />
    <bpmn2:sequenceFlow id="Flow_CartValid_Yes" name="Yes" sourceRef="Gateway_CartValid" targetRef="Task_CheckInventory">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return cartValid;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_CartValid_No" name="No" sourceRef="Gateway_CartValid" targetRef="Task_RejectCheckout">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return !cartValid;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Reject_End" sourceRef="Task_RejectCheckout" targetRef="EndEvent_Rejected" />
    <bpmn2:sequenceFlow id="Flow_CheckInventory_Gateway" sourceRef="Task_CheckInventory" targetRef="Gateway_StockAvailable" />
    <bpmn2:sequenceFlow id="Flow_StockAvailable_Yes" name="Yes" sourceRef="Gateway_StockAvailable" targetRef="Task_ProcessPayment">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return stockAvailable;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_StockAvailable_No" name="No" sourceRef="Gateway_StockAvailable" targetRef="Task_OutOfStock">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return !stockAvailable;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_OutOfStock_End" sourceRef="Task_OutOfStock" targetRef="EndEvent_OutOfStock" />
    <bpmn2:sequenceFlow id="Flow_ProcessPayment_Gateway" sourceRef="Task_ProcessPayment" targetRef="Gateway_PaymentSuccessful" />
    <bpmn2:sequenceFlow id="Flow_PaymentSuccessful_Yes" name="Yes" sourceRef="Gateway_PaymentSuccessful" targetRef="Task_CreateOrder">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return paymentSuccessful;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_PaymentSuccessful_No" name="No" sourceRef="Gateway_PaymentSuccessful" targetRef="Task_PaymentFailed">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return !paymentSuccessful;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_PaymentFailed_End" sourceRef="Task_PaymentFailed" targetRef="EndEvent_PaymentFailed" />
    <bpmn2:sequenceFlow id="Flow_CreateOrder_UpdateInventory" sourceRef="Task_CreateOrder" targetRef="Task_UpdateInventory" />
    <bpmn2:sequenceFlow id="Flow_UpdateInventory_Confirmation" sourceRef="Task_UpdateInventory" targetRef="Task_SendConfirmation" />
    <bpmn2:sequenceFlow id="Flow_Confirmation_Complete" sourceRef="Task_SendConfirmation" targetRef="Task_CompleteCheckout" />
    <bpmn2:sequenceFlow id="Flow_Complete_End" sourceRef="Task_CompleteCheckout" targetRef="EndEvent_Completed" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Checkout">
    <bpmndi:BPMNPlane id="BPMNPlane_Checkout" bpmnElement="Process_Checkout">
      <bpmndi:BPMNShape id="Shape_StartEvent_Checkout" bpmnElement="StartEvent_Checkout">
        <dc:Bounds x="100" y="300" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ValidateCart" bpmnElement="Task_ValidateCart">
        <dc:Bounds x="180" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_CartValid" bpmnElement="Gateway_CartValid" isMarkerVisible="true">
        <dc:Bounds x="350" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RejectCheckout" bpmnElement="Task_RejectCheckout">
        <dc:Bounds x="430" y="430" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Rejected" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="610" y="452" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CheckInventory" bpmnElement="Task_CheckInventory">
        <dc:Bounds x="430" y="280" width="130" height="80" />
      </bpmndi:BPMNShape>
